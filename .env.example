# AgriMind Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# NEVER commit .env to version control.

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./data/agrimind.db

# Storage Paths
UPLOAD_DIR=./data/uploads
KNOWLEDGE_DIR=./data/knowledge
FAISS_INDEX_PATH=./data/knowledge/faiss_index

# Model Provider 1: Google Gemini (Commercial/Proprietary Model 1)
# Sign up at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Model Provider 2: Groq Cloud (Commercial/Proprietary Model 2 - Fast Hosted Inference)
# Sign up at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Model Provider 3: Ollama (Local Open-Weight / Smaller Model)
# Install from https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Tool A: Weather Data API (Open-Meteo is free & keyless, OpenWeather optional)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Optional OpenWeatherMap API Key if used as alternate:
OPENWEATHER_API_KEY=your_openweather_key_here

# Vector Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Execution Safeguards & Budgets
MAX_PLAN_STEPS=10
DEFAULT_STEP_TIMEOUT_SECONDS=30
WORKFLOW_EXECUTION_BUDGET_SECONDS=120
MAX_RETRIES_PER_STEP=2
ENABLE_MOCK_FALLBACKS_FOR_TESTS=true
