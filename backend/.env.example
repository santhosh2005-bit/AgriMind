# AgriMind Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite:///./data/agrimind.db
UPLOAD_DIR=./data/uploads
KNOWLEDGE_DIR=./data/knowledge
FAISS_INDEX_PATH=./data/knowledge/faiss_index

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPENWEATHER_API_KEY=your_openweather_key_if_used

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

MAX_PLAN_STEPS=10
DEFAULT_STEP_TIMEOUT_SECONDS=30
WORKFLOW_EXECUTION_BUDGET_SECONDS=120
MAX_RETRIES_PER_STEP=2
ENABLE_MOCK_FALLBACKS_FOR_TESTS=true
